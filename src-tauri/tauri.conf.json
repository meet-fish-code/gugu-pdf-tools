
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "咕咕PDF工具箱",
  "version": "1.0.101",
  "identifier": "com.gugu.pdftools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "咕咕PDF工具箱",
        "width": 1200,
        "height": 650,
        "minWidth": 550,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/pdf_unlock.exe",
      "binaries/pdf_password.exe",
      "binaries/pdf_compress.exe",
      "binaries/pdf_watermark.exe",
      "binaries/pdf_remove_watermark.exe",
      "binaries/pdf_merge.exe",
      "binaries/pdf_split.exe",
      "binaries/pdf_to_images.exe",
      "binaries/word_to_pdf.exe",
      "binaries/images_to_pdf.exe",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "咕咕PDF工具箱",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer.nsi"
      }
    }
  }
}

